{
  "type": "module",
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch --include openapi --clear-screen=false src/index.ts",
    "build": "tsdown src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "lint:check": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "format": "prettier . --write --list-different",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "fetch-courses": "tsx scripts/fetch-courses.ts",
    "generate-samples": "tsx scripts/generate-samples.ts",
    "setup-dev-db": "tsx scripts/setup-dev-db.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^13.7.0",
    "fuse.js": "^7.3.0",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.2",
    "@types/qs": "^6.15.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.4.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.0.1",
    "pdf-lib": "^1.17.1",
    "prettier": "3.8.1",
    "qs": "^6.15.0",
    "supertest": "^7.2.2",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "24.7.0"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "prettier": {
    "experimentalOperatorPosition": "start",
    "singleQuote": true,
    "objectWrap": "collapse",
    "arrowParens": "avoid",
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@(models|routers|scripts|type|utils)?/",
      "^[.]"
    ],
    "importOrderTypeScriptVersion": "5.9.2",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  },
  "lint-staged": {
    "*": [
      "prettier --check --ignore-unknown"
    ],
    "(src|test|scripts)/**/*.ts": [
      "eslint"
    ]
  }
}
