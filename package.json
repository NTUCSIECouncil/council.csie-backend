{
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch --include openapi --clear-screen=false src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "lint:check": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "format": "prettier . --write --list-different",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "fetch-courses": "tsx scripts/fetch-courses.ts",
    "generate-samples": "tsx scripts/generate-samples.ts",
    "setup-dev-db": "tsx scripts/setup-dev-db.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^13.5.0",
    "fuse.js": "^7.1.0",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "pdf-lib": "^1.17.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "3.6.2",
    "qs": "^6.14.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "24.7.0"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "prettier": {
    "experimentalOperatorPosition": "start",
    "singleQuote": true,
    "objectWrap": "collapse",
    "arrowParens": "avoid",
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@(models|routers|scripts|type|utils)?/",
      "^[.]"
    ],
    "importOrderTypeScriptVersion": "5.9.2",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  },
  "lint-staged": {
    "*": [
      "prettier --check --ignore-unknown"
    ],
    "(src|test|scripts)/**/*.ts": [
      "eslint"
    ]
  }
}
