{
  "type": "module",
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch --include openapi --clear-screen=false src/index.ts",
    "build": "tsdown src/index.ts",
    "start": "node dist/index.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "lint:check": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "format": "prettier . --write --list-different",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "fetch-courses": "tsx scripts/fetch-courses.ts",
    "generate-samples": "tsx scripts/generate-samples.ts",
    "setup-dev-db": "tsx scripts/setup-dev-db.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.1.0",
    "fuse.js": "^7.4.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.11.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.2",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "mongodb-memory-server": "^11.2.0",
    "pdf-lib": "^1.17.1",
    "prettier": "3.9.4",
    "qs": "^6.15.3",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.10.0",
  "prettier": {
    "experimentalOperatorPosition": "start",
    "singleQuote": true,
    "objectWrap": "collapse",
    "arrowParens": "avoid",
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@(models|routers|scripts|type|utils)?/",
      "^[.]"
    ],
    "importOrderTypeScriptVersion": "5.9.2",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  },
  "lint-staged": {
    "*": [
      "prettier --check --ignore-unknown"
    ],
    "(src|test|scripts)/**/*.ts": [
      "eslint"
    ]
  }
}
