{
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx --env-file=.default.env --env-file=.env src/index.ts",
    "dev:watch": "tsx watch --clear-screen=false --env-file=.default.env --env-file=.env src/index.ts",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "setup-dev-db": "tsx --env-file=.default.env --env-file=.env scripts/setup-dev-db.ts && tsx --env-file=.default.env --env-file=.env scripts/setup-dev-file.ts",
    "cleanup-dev-db": "tsx --env-file=.default.env --env-file=.env scripts/cleanup-dev-db.ts",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "express": "^5.0.1",
    "firebase-admin": "^13.1.0",
    "fuse.js": "^7.1.0",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "qs": "^6.13.0",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@stylistic/eslint-plugin": "^4.0.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/qs": "^6.9.18",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.1.4",
    "dotenv": "^16.4.7",
    "eslint": "^9.9.0",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import-x": "^4.1.1",
    "husky": "^9.1.5",
    "lint-staged": "^16.0.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.3"
  },
  "overrides": {
    "glob": "^11.0.0",
    "eslint-import-resolver-typescript": {
      "eslint-plugin-import": "npm:eslint-plugin-import-x"
    }
  },
  "lint-staged": {
    "src/**/*.ts": "eslint",
    "test/**/*.ts": "eslint",
    "scripts/**/*.ts": "eslint"
  }
}
