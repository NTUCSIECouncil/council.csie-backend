{
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch --include openapi --clear-screen=false src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts' --fix",
    "lint:check": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "fetch-courses": "tsx scripts/fetch-courses.ts",
    "generate-samples": "tsx scripts/generate-samples.ts",
    "setup-dev-db": "tsx scripts/setup-dev-db.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "express": "^5.0.1",
    "firebase-admin": "^13.1.0",
    "fuse.js": "^7.1.0",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.6.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.5",
    "@types/qs": "^6.9.18",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^3.1.4",
    "dotenv": "^17.2.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.5",
    "lint-staged": "^16.0.0",
    "mongodb-memory-server": "^10.0.0",
    "prettier": "3.6.2",
    "qs": "^6.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.3"
  },
  "prettier": {
    "experimentalOperatorPosition": "start",
    "singleQuote": true,
    "objectWrap": "collapse",
    "arrowParens": "avoid",
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@(models|routers|scripts|type|utils)?/",
      "^[.]"
    ],
    "importOrderTypeScriptVersion": "5.9.2",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  },
  "lint-staged": {
    "*": [
      "prettier --check --ignore-unknown"
    ],
    "(src|test|scripts)/**/*.ts": [
      "eslint"
    ]
  }
}
