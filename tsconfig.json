{
  "extends": "@tsconfig/node24/tsconfig.json",

  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@models/*": ["./src/models/*"],
      "@routers/*": ["./src/routers/*"],
      "@scripts/*": ["./scripts/*"],
      "@type/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"]
}
